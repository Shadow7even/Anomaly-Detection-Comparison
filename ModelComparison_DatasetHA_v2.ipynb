   "source": [
    "## 6. Baselines (Threshold & Isolation Forest)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "baseline_code",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Baseline 1: Simple Threshold (max ||a|| > θ) ---\n",
    "print(f\"\\n{'=' * 60}\\nBaseline 1: Amplitude Threshold\\n{'=' * 60}\")\n",
    "\n",
    "# Compute acceleration magnitude for all samples\n",
    "accel_norm_val = np.linalg.norm(X_val[:, :, :3], axis=(1, 2))  # max acceleration per window\n",
    "accel_norm_test = np.linalg.norm(X_test[:, :, :3], axis=(1, 2))\n",
    "\n",
    "threshold_amp = np.percentile(accel_norm_val, 95)  # calibrate on val\n",
    "binary_preds_amp = (accel_norm_test >= threshold_amp).astype(int)\n",
    "\n",
    "precision_amp = precision_score(y_test, binary_preds_amp, zero_division=0)\n",
    "recall_amp = recall_score(y_test, binary_preds_amp, zero_division=0)\n",
    "f1_amp = f1_score(y_test, binary_preds_amp, zero_division=0)\n",
    "roc_auc_amp = roc_auc_score(y_test, accel_norm_test)\n",
    "pr_prec_amp, pr_rec_amp, _ = precision_recall_curve(y_test, accel_norm_test)\n",
    "pr_auc_amp = auc(pr_rec_amp, pr_prec_amp)\n",
    "\n",
    "cm_amp = confusion_matrix(y_test, binary_preds_amp)\n",
    "if cm_amp.size == 4:\n",
    "    tn_amp, fp_amp, fn_amp, tp_amp = cm_amp.ravel()\n",
    "else:\n",
    "    tn_amp, fp_amp, fn_amp, tp_amp = 0, 0, 0, 0\n",
    "far_amp = fp_amp / (fp_amp + tn_amp) if (fp_amp + tn_amp) > 0 else 0.0\n",
    "\n",
    "roc_data[\"Threshold\"] = roc_curve(y_test, accel_norm_test)\n",
    "pr_data[\"Threshold\"] = (pr_rec_amp, pr_prec_amp)\n",
    "cms[\"Threshold\"] = cm_amp\n",
    "\n",
    "results[\"Threshold\"] = {\n",
    "    \"precision\": precision_amp,\n",
    "    \"recall\": recall_amp,\n",
    "    \"f1\": f1_amp,\n",
    "    \"roc_auc\": roc_auc_amp,\n",
    "    \"pr_auc\": pr_auc_amp,\n",
    "    \"far\": far_amp,\n",
    "    \"threshold\": threshold_amp,\n",
    "    \"tn\": tn_amp, \"fp\": fp_amp, \"fn\": fn_amp, \"tp\": tp_amp\n",
    "}\n",
    "\n",
    "print(f\"Baseline: max ||accel|| > θ\")\n",
    "print(f\"  Precision:  {precision_amp:.4f}\")\n",
    "print(f\"  Recall:     {recall_amp:.4f}\")\n",
    "print(f\"  PR-AUC:     {pr_auc_amp:.4f}\")\n",
    "print(f\"  FAR:        {far_amp:.4f}\")\n",
    "\n",
    "# --- Baseline 2: Isolation Forest ---\n",
    "print(f\"\\n{'=' * 60}\\nBaseline 2: Isolation Forest\\n{'=' * 60}\")\n",
    "\n",
    "X_train_flat = X_train.reshape(X_train.shape[0], -1)\n",
    "X_val_flat = X_val.reshape(X_val.shape[0], -1)\n",
    "X_test_flat = X_test.reshape(X_test.shape[0], -1)\n",
    "\n",
    "iso_forest = IsolationForest(contamination=0.05, random_state=SEED, n_jobs=-1)\n",
    "iso_forest.fit(X_train_flat)\n",
    "\n",
    "val_iso_scores = -iso_forest.decision_function(X_val_flat)  # negate for \"higher = more anomalous\"\n",
    "iso_threshold = np.percentile(val_iso_scores, 95)\n",
    "\n",
    "test_iso_scores = -iso_forest.decision_function(X_test_flat)\n",
    "binary_preds_iso = (test_iso_scores >= iso_threshold).astype(int)\n",
    "\n",
    "precision_iso = precision_score(y_test, binary_preds_iso, zero_division=0)\n",
    "recall_iso = recall_score(y_test, binary_preds_iso, zero_division=0)\n",
    "f1_iso = f1_score(y_test, binary_preds_iso, zero_division=0)\n",
    "roc_auc_iso = roc_auc_score(y_test, test_iso_scores)\n",
    "pr_prec_iso, pr_rec_iso, _ = precision_recall_curve(y_test, test_iso_scores)\n",
    "pr_auc_iso = auc(pr_rec_iso, pr_prec_iso)\n",
    "\n",
    "cm_iso = confusion_matrix(y_test, binary_preds_iso)\n",
    "if cm_iso.size == 4:\n",
    "    tn_iso, fp_iso, fn_iso, tp_iso = cm_iso.ravel()\n",
    "else:\n",
    "    tn_iso, fp_iso, fn_iso, tp_iso = 0, 0, 0, 0\n",
    "far_iso = fp_iso / (fp_iso + tn_iso) if (fp_iso + tn_iso) > 0 else 0.0\n",
    "\n",
    "roc_data[\"Isolation Forest\"] = roc_curve(y_test, test_iso_scores)\n",
    "pr_data[\"Isolation Forest\"] = (pr_rec_iso, pr_prec_iso)\n",
    "cms[\"Isolation Forest\"] = cm_iso\n",
    "\n",
    "results[\"Isolation Forest\"] = {\n",
    "    \"precision\": precision_iso,\n",
    "    \"recall\": recall_iso,\n",
    "    \"f1\": f1_iso,\n",
    "    \"roc_auc\": roc_auc_iso,\n",
    "    \"pr_auc\": pr_auc_iso,\n",
    "    \"far\": far_iso,\n",
    "    \"threshold\": iso_threshold,\n",
    "    \"tn\": tn_iso, \"fp\": fp_iso, \"fn\": fn_iso, \"tp\": tp_iso\n",
    "}\n",
    "\n",
    "print(f\"Isolation Forest Features: raw flattened window\")\n",
    "print(f\"  Precision:  {precision_iso:.4f}\")\n",
    "print(f\"  Recall:     {recall_iso:.4f}\")\n",
    "print(f\"  PR-AUC:     {pr_auc_iso:.4f}\")\n",
    "print(f\"  FAR:        {far_iso:.4f}\")"
