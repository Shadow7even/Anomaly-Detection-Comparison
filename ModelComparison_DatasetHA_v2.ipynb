    "## 5. Model Evaluation with Proper Metrics (PR-AUC, Precision, Recall)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "evaluation_code",\n",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Evaluate on test set with MAX and P95 aggregation ---\n",
    "print(f\"\\n{'=' * 60}\\nModel Evaluation (Deep Learning Models)\\n{'=' * 60}\")\n",
    "\n",
    "for model_name, model in trained_models.items():\n",
    "    print(f\"\\nEvaluating {model_name}...\")\n",
    "    model.eval()\n",
    "    \n",
    "    # Compute anomaly scores on validation set (for threshold calibration)\n",
    "    val_anomaly_scores = []\n",
    "    with torch.no_grad():\n",
    "        for batch in val_loader:\n",
    "            x_data = batch[0].to(device)\n",
    "            inputs = x_data[:, :-forecast_horizon, :]\n",
    "            targets = x_data[:, -forecast_horizon:, :]\n",
    "            preds = model(inputs)\n",
    "            sample_mse = torch.mean((preds - targets) ** 2, dim=(1, 2)).cpu().numpy()\n",
    "            val_anomaly_scores.extend(sample_mse)\n",
    "    \n",
    "    val_anomaly_scores = np.array(val_anomaly_scores)\n",
    "    threshold_p95 = np.percentile(val_anomaly_scores, 95)\n",
    "    \n",
    "    # Compute anomaly scores on test set\n",
    "    test_anomaly_scores = []\n",
    "    test_labels = []\n",
    "    with torch.no_grad():\n",
    "        for x_batch, y_batch in test_loader:\n",
    "            x_batch = x_batch.to(device)\n",
    "            inputs = x_batch[:, :-forecast_horizon, :]\n",
    "            targets = x_batch[:, -forecast_horizon:, :]\n",
    "            preds = model(inputs)\n",
    "            sample_mse = torch.mean((preds - targets) ** 2, dim=(1, 2)).cpu().numpy()\n",
    "            test_anomaly_scores.extend(sample_mse)\n",
    "            test_labels.extend(y_batch.numpy())\n",
    "    \n",
    "    test_anomaly_scores = np.array(test_anomaly_scores)\n",
    "    test_labels = np.array(test_labels)\n",
    "    anomaly_scores_dict[model_name] = test_anomaly_scores\n",
    "    \n",
    "    # Binary predictions at p95 threshold\n",
    "    binary_preds = (test_anomaly_scores >= threshold_p95).astype(int)\n",
    "    \n",
    "    # Metrics\n",
    "    precision = precision_score(test_labels, binary_preds, zero_division=0)\n",
    "    recall = recall_score(test_labels, binary_preds, zero_division=0)\n",
    "    f1 = f1_score(test_labels, binary_preds, zero_division=0)\n",
    "    roc_auc = roc_auc_score(test_labels, test_anomaly_scores)\n",
    "    \n",
    "    # PR-AUC (PRIMARY METRIC per dataset README)\n",
    "    pr_precision, pr_recall, _ = precision_recall_curve(test_labels, test_anomaly_scores)\n",
    "    pr_auc = auc(pr_recall, pr_precision)\n",
    "    \n",
    "    cm = confusion_matrix(test_labels, binary_preds)\n",
    "    if cm.size == 4:\n",
    "        tn, fp, fn, tp = cm.ravel()\n",
    "    else:\n",
    "        tn, fp, fn, tp = 0, 0, 0, 0\n",
    "    \n",
    "    far = fp / (fp + tn) if (fp + tn) > 0 else 0.0\n",
    "    \n",
    "    roc_data[model_name] = roc_curve(test_labels, test_anomaly_scores)\n",
    "    pr_data[model_name] = (pr_recall, pr_precision)\n",
    "    cms[model_name] = cm\n",
    "    \n",
    "    results[model_name] = {\n",
    "        \"precision\": precision,\n",
    "        \"recall\": recall,\n",
    "        \"f1\": f1,\n",
    "        \"roc_auc\": roc_auc,\n",
    "        \"pr_auc\": pr_auc,\n",
    "        \"far\": far,\n",
    "        \"threshold\": threshold_p95,\n",
    "        \"tn\": tn, \"fp\": fp, \"fn\": fn, \"tp\": tp\n",
    "    }\n",
    "    \n",
    "    print(f\"  Precision:  {precision:.4f}\")\n",
    "    print(f\"  Recall:     {recall:.4f}\")\n",
    "    print(f\"  F1:         {f1:.4f}\")\n",
    "    print(f\"  ROC-AUC:    {roc_auc:.4f}\")\n",
    "    print(f\"  PR-AUC:     {pr_auc:.4f}  ← Primary metric\")\n",
    "    print(f\"  FAR (False Alarm Rate): {far:.4f}\")\n",
    "    print(f\"  Threshold (p95):        {threshold_p95:.6f}\")"
   ]
